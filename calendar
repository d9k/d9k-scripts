#!/bin/bash
# ncal -b -M -3 

# https://stackoverflow.com/q/13168463
NEXT_MONTH=`date +'%m' -d 'next month'`
THIS_MONTH=`date +'%m' -d 'now'`
YEAR=`date +'%Y'`

function calendar_month { MONTH_SHIFT="$1"
  printf "\n"
  SHIFTED_MONTH=$(date +'%m' -d "$MONTH_SHIFT months")
  SHIFTED_YEAR=$(date +'%Y' -d "$MONTH_SHIFT months")
  ncal -b -M "$SHIFTED_MONTH" "$SHIFTED_YEAR"
}

printf "\n"
calendar_month -1
calendar_month 0
calendar_month +1
calendar_month +2
printf "\n"
