  ;;
  "$COMMAND_TELEGRAM_MOVE_TO_TOP_AT_MOUSE_CURSOR_TITLE" )
    ${COMMAND_TELEGRAM_MOVE_TO_TOP_AT_MOUSE_CURSOR}
  ;;
  "$COMMAND_TELEGRAM_MOVE_TO_SAVED_AT_MOUSE_CURSOR_TITLE" )
    ${COMMAND_TELEGRAM_MOVE_TO_SAVED_AT_MOUSE_CURSOR}
  ;;
  "$COMMAND_FIREFOX_TELEGRAM_OPEN_CMD_PALETTE_TITLE" )
    ${COMMAND_FIREFOX_TELEGRAM_OPEN_CMD_PALETTE}
  ;;
