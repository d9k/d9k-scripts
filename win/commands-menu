# sleep 1
# $COMMAND_RUN_SELECTION_IN_TERMINAL
# exit

MENU_ITEMS=""

if [ -n "$($IS_FOCUSED TelegramDesktop)" ]; then
MENU_ITEMS+="\n$(cat << END_OF_MENU
${COMMAND_TELEGRAM_EDIT_AT_MOUSE_CURSOR_TITLE}
${COMMAND_TELEGRAM_REPOST_AT_MOUSE_CURSOR_TITLE}
${COMMAND_TELEGRAM_COPY_AT_MOUSE_CURSOR_TITLE}
${COMMAND_TELEGRAM_MOVE_TO_TOP_AT_MOUSE_CURSOR_TITLE}
${COMMAND_TELEGRAM_MOVE_TO_SAVED_AT_MOUSE_CURSOR_TITLE}
${COMMAND_TELEGRAM_DELETE_AT_MOUSE_CURSOR_TITLE}
END_OF_MENU
)"
# echo "M: $MENU_ITEMS"
fi

if [ -n "$($IS_FOCUSED Firefox-Telegram)" ]; then
MENU_ITEMS+="\n$(cat << END_OF_MENU
${COMMAND_FIREFOX_TELEGRAM_MESSAGE_COPY_TITLE}
${COMMAND_FIREFOX_TELEGRAM_MESSAGE_EDIT_TITLE}
${COMMAND_FIREFOX_TELEGRAM_MESSAGE_FORWARD_TITLE}
${COMMAND_FIREFOX_TELEGRAM_MOVE_TO_TOP_AT_MOUSE_CURSOR_TITLE}
${COMMAND_FIREFOX_TELEGRAM_MESSAGE_SAFER_DELETE_TITLE}
${COMMAND_FIREFOX_TELEGRAM_MESSAGE_DELETE_TITLE}
${COMMAND_FIREFOX_TELEGRAM_OPEN_CMD_PALETTE_TITLE}
END_OF_MENU
)"
# echo "M1: $MENU_ITEMS"
fi

MENU_ITEMS+="\n$(cat << END_OF_MENU
${COMMAND_SAY_SELECTION_WITH_RHVOICE_TITLE}
${COMMAND_COPY_IN_BACKTICKS_TITLE}
${COMMAND_RUN_SELECTION_IN_TERMINAL_TITLE}
${COMMAND_SELECTION_CURL_ARGS_TRANSFORM_TITLE}
${COMMAND_SELECTION_JSON_PRETTY_PRINT_TITLE}
${COMMAND_CHROME_DEVTOOLS_COPY_TOKEN_TITLE}
${COMMAND_CHROME_DEVTOOLS_COPY_URL_TITLE}
${COMMAND_WMCTRL_LIST_FIRST_IDS_ADD_TITLE}
END_OF_MENU
)"
# echo "M2: $MENU_ITEMS"

# remove empty lines
MENU_ITEMS=$(echo -e "$MENU_ITEMS" | awk 'NF')

# ACTUAL MENU DISPLAY
RESULT=$(\
  echo -e "$MENU_ITEMS" | \
  rofi -dmenu -i \
)

sleep 0.1

case "$RESULT" in
  "${COMMAND_RUN_SELECTION_IN_TERMINAL_TITLE}" )
    ${COMMAND_RUN_SELECTION_IN_TERMINAL}
  ;;
  "${COMMAND_COPY_IN_BACKTICKS_TITLE}" )
    ${COMMAND_COPY_IN_BACKTICKS}
  ;;
  "${COMMAND_SAY_SELECTION_WITH_RHVOICE_TITLE}" )
    ${COMMAND_SAY_SELECTION_WITH_RHVOICE}
  ;;
  "${COMMAND_SELECTION_CURL_ARGS_TRANSFORM_TITLE}" )
    ${COMMAND_SELECTION_CURL_ARGS_TRANSFORM}
  ;;
  "${COMMAND_SELECTION_JSON_PRETTY_PRINT_TITLE}" )
    ${COMMAND_SELECTION_JSON_PRETTY_PRINT}
  ;;
  "${COMMAND_CHROME_DEVTOOLS_COPY_TOKEN_TITLE}" )
    ${COMMAND_CHROME_DEVTOOLS_COPY_TOKEN}
  ;;
  "${COMMAND_WMCTRL_LIST_FIRST_IDS_ADD_TITLE}" )
    ${COMMAND_WMCTRL_LIST_FIRST_IDS_ADD}
  ;;
  "$COMMAND_TELEGRAM_REPOST_AT_MOUSE_CURSOR_TITLE" )
    ${COMMAND_TELEGRAM_REPOST_AT_MOUSE_CURSOR}
  ;;
  "$COMMAND_TELEGRAM_DELETE_AT_MOUSE_CURSOR_TITLE" )
    ${COMMAND_TELEGRAM_DELETE_AT_MOUSE_CURSOR}
  ;;
