COMMAND_TELEGRAM_REPOST_AT_MOUSE_CURSOR_TITLE="Telegram: repost at mouse cursor"

COMMAND_TELEGRAM_DELETE_AT_MOUSE_CURSOR="${SCRIPTS}/win/telegram-safer-delete-at-mouse-cursor.sh"
COMMAND_TELEGRAM_DELETE_AT_MOUSE_CURSOR_TITLE="Telegram: /!\ DELETE at mouse cursor"

COMMAND_TELEGRAM_EDIT_AT_MOUSE_CURSOR="${SCRIPTS}/win/telegram-edit-at-mouse-cursor.sh"
COMMAND_TELEGRAM_EDIT_AT_MOUSE_CURSOR_TITLE="Telegram: edit at mouse cursor"

COMMAND_TELEGRAM_COPY_AT_MOUSE_CURSOR="${SCRIPTS}/win/telegram-copy-at-mouse-cursor.sh"
COMMAND_TELEGRAM_COPY_AT_MOUSE_CURSOR_TITLE="Telegram: copy at mouse cursor"

COMMAND_TELEGRAM_MOVE_TO_TOP_AT_MOUSE_CURSOR="${SCRIPTS}/win/telegram-move-to-top-at-mouse-cursor.sh"
COMMAND_TELEGRAM_MOVE_TO_TOP_AT_MOUSE_CURSOR_TITLE="Telegram: move to top at mouse cursor as text"

COMMAND_TELEGRAM_MOVE_TO_SAVED_AT_MOUSE_CURSOR="${SCRIPTS}/win/telegram-move-to-saved-at-mouse-cursor.sh"
COMMAND_TELEGRAM_MOVE_TO_SAVED_AT_MOUSE_CURSOR_TITLE="Telegram: move to /save/ at mouse cursor"

COMMAND_FIREFOX_TELEGRAM_OPEN_CMD_PALETTE="${SCRIPTS}/win/firefox-telegram-open-cmd-palette.sh"
COMMAND_FIREFOX_TELEGRAM_OPEN_CMD_PALETTE_TITLE="Firefox Telegram: open cmd palette (Ctrl-Alt-P)"

COMMAND_FIREFOX_TELEGRAM_MESSAGE_COPY="${SCRIPTS}/win/firefox-telegram-message-copy.sh"
COMMAND_FIREFOX_TELEGRAM_MESSAGE_COPY_TITLE="Firefox Telegram: message copy at mouse cursor"

COMMAND_FIREFOX_TELEGRAM_MESSAGE_EDIT="${SCRIPTS}/win/firefox-telegram-message-edit.sh"
