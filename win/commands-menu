    ${COMMAND_FIREFOX_TELEGRAM_MESSAGE_COPY}
  ;;
  "$COMMAND_FIREFOX_TELEGRAM_MESSAGE_EDIT_TITLE" )
    ${COMMAND_FIREFOX_TELEGRAM_MESSAGE_EDIT}
  ;;
  "$COMMAND_FIREFOX_TELEGRAM_MESSAGE_FORWARD_TITLE" )
    ${COMMAND_FIREFOX_TELEGRAM_MESSAGE_FORWARD}
  ;;
  "$COMMAND_FIREFOX_TELEGRAM_MESSAGE_DELETE_TITLE" )
    ${COMMAND_FIREFOX_TELEGRAM_MESSAGE_DELETE}
  ;;
  "$COMMAND_FIREFOX_TELEGRAM_MOVE_TO_TOP_AT_MOUSE_CURSOR_TITLE" )
    ${COMMAND_FIREFOX_TELEGRAM_MOVE_TO_TOP_AT_MOUSE_CURSOR}
  ;;
  "$COMMAND_FIREFOX_TELEGRAM_MESSAGE_SAFER_DELETE_TITLE" )
    ${COMMAND_FIREFOX_TELEGRAM_MESSAGE_SAFER_DELETE}
  ;;
esac
