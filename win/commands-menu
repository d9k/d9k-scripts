COMMAND_FIREFOX_TELEGRAM_MESSAGE_DELETE="${SCRIPTS}/win/firefox-telegram-message-delete.sh"
COMMAND_FIREFOX_TELEGRAM_MESSAGE_DELETE_TITLE="Firefox Telegram: /!\ DELETE message at mouse cursor"

COMMAND_FIREFOX_TELEGRAM_MESSAGE_SAFER_DELETE="${SCRIPTS}/win/firefox-telegram-message-safer-delete.sh"
COMMAND_FIREFOX_TELEGRAM_MESSAGE_SAFER_DELETE_TITLE="Firefox Telegram: message safer delete at mouse cursor"

COMMAND_FIREFOX_TELEGRAM_MOVE_TO_TOP_AT_MOUSE_CURSOR="${SCRIPTS}/win/firefox-telegram-move-to-top-at-mouse-cursor.sh"
