#!/bin/bash

SCRIPT_NAME="$(basename "$(test -L "$0" && readlink "$0" || echo "$0")")"
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"

YOUTUBE_VIDEO_ID_PATTERN='[A-Za-z0-9_-]{11}'

function echoerr {
  printf "%s\n" "$*" >&2;
}

function help_exit { EXIT_CODE="$1";
  if [[ -z "$EXIT_CODE" ]]; then
    EXIT_CODE=1
  fi

  echoerr "Usage: $SCRIPT_NAME [YOUTUBE_DL_ARGS...] URL_OR_ID"
  exit $EXIT_CODE
}

LAST_ARG="${@: -1}"

if [[ -z "$LAST_ARG" ]]; then
  help_exit 100
fi

YOUTUBE_VIDEO_ID="$(printf '%s\n' "$LAST_ARG" | grep -oE "$YOUTUBE_VIDEO_ID_PATTERN" | head -n 1)"

if [[ -z "$YOUTUBE_VIDEO_ID" ]]; then
  echoerr "Error: cannot parse YOUTUBE_VIDEO_ID from LAST_ARG '$LAST_ARG'"
  help_exit 150
fi

"$SCRIPT_DIR/youtube-dl-srt" "$@"

shopt -s nullglob

SRT_FILES=( *"$YOUTUBE_VIDEO_ID"*.srt )

if [[ ${#SRT_FILES[@]} -eq 0 ]]; then
  echoerr "Error: no .srt files found for YOUTUBE_VIDEO_ID '$YOUTUBE_VIDEO_ID'"
  exit 200
fi

for SRT_FILE in "${SRT_FILES[@]}"; do
  cp -- "$SRT_FILE" "$SRT_FILE.txt"
done

CURRENT_DIR=$(pwd)

ls -1 $CURRENT_DIR/*"$YOUTUBE_VIDEO_ID"*.srt.txt