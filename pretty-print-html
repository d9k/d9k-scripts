#!/bin/bash

SCRIPT_NAME="$(basename "$(test -L "$0" && readlink "$0" || echo "$0")")"

COMMAND_PACKAGE_INSTALL="go install codeberg.org/derat/htmlpretty/cmd/htmlpretty@latest"

INDENT="    "

function echoerr {
  printf "%s\n" "$*" >&2;
}

function help_exit { EXIT_CODE="$1";
  if [[ -z "$EXIT_CODE" ]]; then
    EXIT_CODE=1
  fi

  echoerr "Usage: $SCRIPT_NAME [INPUT_PATH]"
  echoerr "Pretty-print an HTML5 document from INPUT_PATH or stdin."
  exit $EXIT_CODE
}

function ask_yes_no { PROMPT="$1";
  local REPLY
  read -r -p "$PROMPT" REPLY < /dev/tty || return 1
  [[ "$REPLY" == "y" || "$REPLY" == "Y" || "$REPLY" == "д" || "$REPLY" == "Д" ]]
}

if ! command -v htmlpretty >/dev/null 2>&1; then
  echoerr "htmlpretty is not installed. You may install it with:"
  echoerr "  $COMMAND_PACKAGE_INSTALL"

  if ! ask_yes_no "Install htmlpretty now? [y/N] "; then
    echoerr "Error: htmlpretty is not installed"
    exit 100
  fi

  eval "$COMMAND_PACKAGE_INSTALL" || { echoerr "Error: htmlpretty installation failed"; exit 150; }

  export PATH="$(go env GOPATH)/bin:$PATH"
fi

INPUT_PATH="$1"

# Check input pipe
# (See https://unix.stackexchange.com/a/388462)

if [ ! -t 0 ]; then
  htmlpretty -indent="$INDENT"
elif [[ -n "$INPUT_PATH" ]]; then
  htmlpretty -indent="$INDENT" "$INPUT_PATH"
else
  help_exit 200
fi
