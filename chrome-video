#!/bin/bash

# export PAGE="https://metrics.torproject.org/rs.html"

PAGE="https://www.youtube.com/feed/history"
WINDOW_NAME="Chrome Video"

# PORT=1080
# PORT=1096
# PORT=987
PORT=10808

# --proxy-server="http://127.0.0.1:9119" \

chrome \
  --private \
  --proxy-server="socks5://127.0.0.1:$PORT" \
  --window-name="$WINDOW_NAME" \
  --user-data-dir="$HOME/temp/chrome-data-dir-proxy" \
  --enable-features=AcceleratedVideoDecodeLinux,AcceleratedVideoEncoder \
  --profile-directory="Default"
  #\
  # "$PAGE"

