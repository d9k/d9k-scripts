#!/bin/bash

ALIAS="$1"
FILE="$2"

DIR="$(pwd)"

OUTPUT="$HOME/.aliases-temp"

export $ALIAS="$DIR"

if [[ -n "$ALIAS" ]]; then
  if [[ -n "$FILE" ]]; then
    echo "export $ALIAS=\"$DIR/$FILE\"" >> "$OUTPUT"
  else  
    echo "export $ALIAS=\"$DIR\"" >> "$OUTPUT"
  fi
fi

echo "..."
tail "$OUTPUT"
echo

if [[ -z "$ALIAS" ]]; then
  echo "Error: Alias was not provided!"
else
  echo "Run"
  echo ". $OUTPUT"
fi
