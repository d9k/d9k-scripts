MAX_LINES_PREVIEW=12

# sudo apt-get install stardict sdcv
RESULT=$(sdcv --non-interactive "$@")  

if [[ "$RESULT" == "" ]]; then
  echo "No matches"
  exit
fi

RESULT=$( \
  echo -e "$RESULT" \
    | grep -v "Found 1 items, similar" \
    | sed '/^$/d' `# remove trailing empty lines` \
    | grep -v "\-\->" \
    | sed 's|<t>|[|g' \
    | sed 's|</t>|]|g' \
    | sed 's|<br>|\n\n|g' \
    | rg --passthru --multiline --replace '$2                    $1' '^(.*)\n(\[.*)$' 
)

# | rg --passthru --multiline --replace ' $1' '\n(\[.*)$' \

LINES_COUNT=$(echo -e "$RESULT" | wc -l)

if [ "$LINES_COUNT" -lt "$MAX_LINES_PREVIEW" ]; then
  echo -e "$RESULT"
else

  RESULT_HEAD=$(echo -e "$RESULT" | head -n $MAX_LINES_PREVIEW)
  echo -e "$RESULT_HEAD"
  # echo ". . . . . . . . . ."
  # echo ". . . . ."
  echo -e ". . . . ."
  echo -e "$RESULT" | less 
  #--quit-if-one-screen
fi


